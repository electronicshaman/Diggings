{
  "name": "atlas",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack web application for creating, editing, and browsing narrative graph nodes",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @atlas/backend db:migrate",
    "db:seed": "pnpm --filter @atlas/backend db:seed",
    "db:generate": "pnpm --filter @atlas/backend db:generate",
    "db:studio": "pnpm --filter @atlas/backend db:studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^1.6.1",
    "vitest": "^1.6.1"
  }
}
