{
  "mcpServers": {
    "godot-mcp": {
      "command": "/opt/homebrew/bin/uv",
      "args": [
        "run",
        "src/addons/gdai-mcp-plugin-godot/gdai_mcp_server.py"
      ],
      "autoApprove": [
        "search_files",
        "get_scene_tree",
        "open_scene",
        "play_scene",
        "get_running_scene_screenshot",
        "simulate_input",
        "get_input_map",
        "get_godot_errors",
        "stop_running_scene",
        "clear_output_logs",
        "execute_editor_script",
        "get_filesystem_tree",
        "view_script",
        "get_scene_file_content",
        "create_scene",
        "attach_script",
        "delete_scene"
      ]
    },
    "Context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "YOUR_API_KEY"
      ],
      "env": {},
      "disabled": false,
      "autoApprove": []
    }
  }
}