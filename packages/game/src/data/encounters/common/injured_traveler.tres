[resource]
script = ExtResource("1")
encounter_name = "Injured Traveler"
description = "Along the track, you find a man lying beside his overturned cart, blood seeping from a gash on his leg. He's conscious but weak. 'Help me, please,' he whispers. 'My horse spooked at a snake. I think my leg's broken.' His supplies are scattered nearby."
flavor_text = "When civilization is distant, character is tested..."
rarity = "Common"
encounter_type = "Mixed"
