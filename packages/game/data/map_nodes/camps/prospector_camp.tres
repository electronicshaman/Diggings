safe = true
can_revisit = true
available_actions = Array[String](["rest", "quick_rest", "tend_fire"])
custom_properties = {
"camp_type": "improved",
"fire_quality": "excellent",
"shelter_quality": "good",
"water_source": true,
"visibility": "good",
"previous_visitors": ["prospectors", "traders"],
"carved_messages": true
}
action_properties = {
"rest": {
"description": "Rest by the excellent campfire with good shelter from the elements.",
"heal_amount": 18,
"sanity_change": 12,
"time_cost_hours": 4
},
"quick_rest": {
"description": "Take advantage of the good shelter for a brief rest.",
"heal_amount": 10,
"sanity_change": 8,
"time_cost_hours": 2
},
"tend_fire": {
"description": "The well-maintained fire pit provides excellent warmth and comfort.",
