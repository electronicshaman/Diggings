[resource]
script = ExtResource("1")
node_type = 1
node_name = "Prospector's Rest"
description = "A well-used camping spot favored by prospectors. The fire pit shows signs of recent use and there are carved messages from previous visitors."
visual_size = Vector2(64, 64)
visual_color = Color(0.133333, 0.545098, 0.133333, 1)
