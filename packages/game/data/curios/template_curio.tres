[gd_resource type="Resource" script_class="CurioData" load_steps=3 format=3]

[ext_resource type="Script" path="res://data/CurioData.gd" id="1"]
[ext_resource type="Script" path="res://scripts/curios/effects/ResourceGain.gd" id="2"]

[sub_resource type="Resource" id="SubResource_1"]
script = ExtResource("2")
effect_name = "Template Effect"
description = "Gain X resource when Y happens"
trigger_event = "combat_start"
only_first_per_combat = false
only_first_per_turn = false
chance_to_trigger = 1.0
resource_type = "gold"
amount = 1
random_range = false
condition = ""

[resource]
script = ExtResource("1")

# ============================================
# BASIC INFORMATION
# ============================================
# The display name of the curio
curio_name = "Template Curio"

# Mechanical description shown to player (what it does)
description = "This is a template curio. Replace with actual effect description."

# Icon texture (leave null for now, will be added when art is ready)
icon = null

# Lore/flavor text for thematic immersion
flavor_text = "A mysterious artifact from the goldfields..."

# ============================================
# MECHANICAL PROPERTIES
# ============================================
# Category determines the type of effect:
# - "Passive": Always active effects
# - "Triggered": Activate on specific game events  
# - "Modifier": Change game rules or mechanics
# - "Resource": Affect resource generation or management
mechanical_category = "Passive"

# Rarity tier affects drop rates and power level:
# - "Common": Simple effects, frequent drops
# - "Rare": Complex effects, uncommon drops
# - "Legendary": Run-defining effects, very rare
# - "Corrupted": Powerful with drawbacks, special events
rarity = "Common"

# Whether multiple copies stack their effects
stackable = false

# Maximum number of stacks if stackable (typically 2-4)
max_stacks = 1

# ============================================
# EFFECTS ARRAY
# ============================================
# Array of CurioEffect resources that define what this curio does
# Can have multiple effects with different triggers
# Common trigger events:
# - "passive": Always active
# - "combat_start": When combat begins
# - "turn_start": At the start of each turn
# - "turn_end": At the end of each turn
# - "card_played": When any card is played
# - "damage_dealt": When dealing damage
# - "damage_taken": When taking damage  
# - "enemy_defeated": When an enemy dies
# - "rest": At rest sites
# - "shop_entered": When entering a shop
# - "node_selected": When choosing a map node
effects = [SubResource("SubResource_1")]

# ============================================
# COSTS AND REQUIREMENTS
# ============================================
# Gold cost in shops (affected by rarity multipliers)
# Common: 50-150, Rare: 150-300, Legendary: 300-500, Corrupted: 100-200
gold_cost = 100

# Corruption cost (only for Corrupted curios, typically 1-3)
corruption_cost = 0

# Optional unlock requirement (e.g., "defeat_boss_no_damage")
# Leave empty for always available
unlock_requirement = ""

# ============================================
# CLASS SYNERGIES
# ============================================
# Synergy scores from 0.5 to 2.0:
# 0.5-0.8: Poor synergy (works against class strengths)
# 0.9-1.1: Neutral synergy
# 1.2-1.5: Good synergy (complements class)
# 1.6-2.0: Excellent synergy (amplifies class strengths)

# Bushranger: Aggressive, high damage, attack-focused
bushranger_synergy = 1.0

# Prospector: Resource management, gold generation, card draw
prospector_synergy = 1.0

# Tracker: Defensive, setup, trap-based
tracker_synergy = 1.0

# Publican: Support, healing, team buffs
publican_synergy = 1.0

# ============================================
# VISUAL PROPERTIES
# ============================================
# Color of the glow effect when triggered
# Common: Color.GRAY, Rare: Color.CYAN, 
# Legendary: Color.GOLD, Corrupted: Color.PURPLE
glow_color = Color(1.0, 1.0, 1.0, 1.0)

# Optional particle effect scene to play on trigger
trigger_particle = null