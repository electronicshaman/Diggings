[resource]
script = ExtResource("1")
encounter_name = "Redback in the Swag"
description = "As you prepare to rest for the night, you spot a distinctive red marking on a black spider nestled in your bedroll. A female redback - small but deadly. She seems content in her new web, but you need to sleep somewhere."
flavor_text = "Even the smallest creatures in Australia can kill you..."
rarity = "Common"
encounter_type = "Negative"
repeatable = true
