[resource]
script = ExtResource("1")
encounter_name = "Lost Prospector"
description = "You encounter a weathered prospector stumbling through the terrain, clearly disoriented and parched. His water bottle is empty and he's been walking in circles for hours. 'Please mate,' he croaks, 'I've lost my way back to town. Can you spare some water?'"
flavor_text = "In the goldfields, today's helper might be tomorrow's lifesaver..."
rarity = "Common"
encounter_type = "Mixed"
repeatable = true
max_occurrences = -1
weight = 1.0
choices = [SubResource("3"), SubResource("5"), SubResource("8")]
min_gold = -1
