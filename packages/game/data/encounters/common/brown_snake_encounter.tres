[resource]
script = ExtResource("1")
encounter_name = "Brown Snake Encounter"
description = "You freeze as you spot the unmistakable brown coils of an Eastern Brown Snake among the scrub. One of Australia's deadliest, it hasn't noticed you yet. Your heart pounds as you consider your options."
flavor_text = "The serpent's dark eyes glint with ancient menace..."
rarity = "Common"
encounter_type = "Negative"
repeatable = true
