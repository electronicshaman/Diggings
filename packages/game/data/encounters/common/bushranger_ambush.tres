[resource]
script = ExtResource("1")
encounter_id = "C10"
encounter_name = "Bushranger Ambush"
description = "A rough voice calls out from behind a gum tree. 'Stand and deliver!' Two armed men step onto the track, their faces hidden beneath wide-brimmed hats. One levels a pistol at your chest while the other eyes your belongings with a greedy glint."
flavor_text = "The bush has eyes, and sometimes they belong to desperate men..."
rarity = "Common"
encounter_type = "Negative"
repeatable = true
max_occurrences = -1
weight = 1.2
choices = [SubResource("fight_choice"), SubResource("flee_choice")]
