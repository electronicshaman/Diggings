[resource]
script = ExtResource("1")
encounter_name = "Found Supplies"
description = "Hidden beneath a rocky overhang, you discover a cache of supplies - food, tools, and a small pouch of gold. There's a note: 'Emergency stash - J. McKenzie, returning Tuesday.' Today is Monday. The supplies look valuable, and no one's around to see what you do."
flavor_text = "Character is what you do when nobody's watching..."
rarity = "Common"
